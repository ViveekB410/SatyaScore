# Satya-Score on Hugging Face Spaces (Docker SDK). Generated by deploy/push_to_hf.py.
# The Space repository holds only this Dockerfile, README.md, fetch_bundle.py and the
# requirements files. Code, web build and corpus come from the private bundle repository
# {{BUNDLE_REPO}}, read at build time with the HF_TOKEN Space secret, so the source code
# is not published with the Space.
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/app/.cache/huggingface TOKENIZERS_PARALLELISM=false

WORKDIR /app

# CPU build of torch: the free Space has no GPU, and this wheel is ~180 MB instead of several GB.
RUN pip install torch==2.13.0 --index-url https://download.pytorch.org/whl/cpu

# Libraries at the versions tested on the development laptop (requirements-lock.txt).
COPY requirements.txt requirements-lock.txt ./
RUN pip install -r requirements.txt -c requirements-lock.txt && \
    python -m spacy download en_core_web_sm

# Models used at request time, baked into the image (XLM-R embedder, mDeBERTa NLI).
RUN python -c "from sentence_transformers import SentenceTransformer; \
SentenceTransformer('sentence-transformers/paraphrase-xlm-r-multilingual-v1'); \
from transformers import AutoTokenizer, AutoModelForSequenceClassification; \
AutoTokenizer.from_pretrained('MoritzLaurer/mDeBERTa-v3-base-mnli-xnli'); \
AutoModelForSequenceClassification.from_pretrained('MoritzLaurer/mDeBERTa-v3-base-mnli-xnli')"

# Corpus (102,069 passages): changes rarely, so it is its own layer.
COPY fetch_bundle.py ./
RUN --mount=type=secret,id=HF_TOKEN,mode=0444,required=true \
    python fetch_bundle.py {{BUNDLE_REPO}} {{DATA_REV}} corpus_passages_expanded.json corpus_vectors_expanded.npy

# Application code and the built web app.
RUN --mount=type=secret,id=HF_TOKEN,mode=0444,required=true \
    python fetch_bundle.py {{BUNDLE_REPO}} {{CODE_REV}} code.tar.gz

# Hugging Face runs the container as user 1000: it must be able to write instance/ (database, caches).
RUN useradd -m -u 1000 user && mkdir -p /app/instance && chown -R user /app
USER user

# Models are in the image, so no Hub access at runtime. HTTPS on *.hf.space -> Secure cookie.
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 SATYASCORE_COOKIE_SECURE=true
EXPOSE 7860
CMD ["uvicorn", "member3_backend.serve:create_app", "--factory", "--host", "0.0.0.0", "--port", "7860", \
     "--proxy-headers", "--forwarded-allow-ips", "*"]
